# Model credentials
# Set the variable required by the providers selected in config.json.
CEREBRAS_API_KEY=your_cerebras_key_here
ELEVEN_API_KEY=your_elevenlabs_key_here

# Optional alternatives for config.json
OPENROUTER_API_KEY=
LLM_API_KEY=

# Local LiveKit development credentials. Replace outside local development.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=AI-LiveKit-Agent
# LIVEKIT_NODE_IP=192.168.1.10

# FastAPI
PORT=8801
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional outside Docker. Defaults to app/backend/doseluma.db.
DOSELUMA_DB_PATH=

# Optional caregiver integrations
CAREGIVER_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAREGIVER_PHONE_NUMBER=
SECONDARY_CONTACT_PHONE_NUMBER=
