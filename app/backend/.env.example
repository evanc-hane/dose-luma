# Ollama AI Agent Configuration
OLLAMA_URL=http://localhost:11434
QWEN_MODEL=hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:latest

# Custom Model Service (Wave2Vec + Attention Classifier)
CUSTOM_MODEL_PORT=8001

# AWS S3 Configuration (for audio storage)
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here

# Google Gemini API (optional fallback)
GEMINI_KEY=your_gemini_api_key_here

# Security Configuration
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

CAREGIVER_WEBHOOK_URL=
# Optional outbound POST target for caregiver alerts. Leave blank to skip.
# Example: https://webhook.site/your-id

ALI_BACKEND_URL=http://127.0.0.1:8801

# Twilio SMS plus Tier 2/3 escalation calls. Leave blank to skip; the system
# runs without it, but
# without the SMS/phone-call legs (webhook + in-app alerts still work).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAREGIVER_PHONE_NUMBER=
SECONDARY_CONTACT_PHONE_NUMBER=
