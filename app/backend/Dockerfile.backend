FROM python:3.11-slim

WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependencies
COPY pyproject.toml uv.lock ./

# Install Python dependencies
RUN uv sync --no-dev

# Copy backend code
COPY . .

# Expose FastAPI port
EXPOSE 8801

# Start FastAPI
CMD ["uv", "run", "uvicorn", "index:app", "--host", "0.0.0.0", "--port", "8801"]
