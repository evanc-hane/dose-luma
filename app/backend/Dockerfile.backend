FROM python:3.11-slim

WORKDIR /app

# Pin the environment tool so container builds remain reproducible.
RUN pip install --no-cache-dir uv==0.11.33

# Copy dependencies
COPY pyproject.toml uv.lock ./

# Install Python dependencies
RUN uv sync --locked --no-dev

# Copy backend code
COPY . .

# Expose FastAPI port
EXPOSE 8801

# Start FastAPI
CMD ["uv", "run", "uvicorn", "index:app", "--host", "0.0.0.0", "--port", "8801"]
